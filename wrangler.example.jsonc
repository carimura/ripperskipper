// The game on Cloudflare Workers: copy this to wrangler.jsonc (kept out of git) and fill in your own names and domain.
// `npm run deploy` builds the game to dist/ and publishes it, with worker/index.js in front for the shared leaderboard (/api/scores, stored in D1).
// `npm run api` runs the same Worker locally with a local database, for `npm run dev`.
{
  "name": "your-worker-name",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "your-scores-db" }],   // no id: wrangler finds it by name (it created it on the first deploy)
  "routes": [{ "pattern": "game.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
